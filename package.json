{
  "name": "smartflow",
  "version": "0.0.0",
  "private": true,
  "description": "SmartFlow is an extensible visual workspace with required 3D scene support.",
  "keywords": [
    "smartflow",
    "visual-programming",
    "node-graphs",
    "workflows",
    "3d",
    "extensible"
  ],
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "test:browser": "node tools/browser-tests.mjs test",
    "test:browser:production": "node tools/browser-tests.mjs --production test",
    "test:browser:install": "node tools/browser-tests.mjs install chromium",
    "dev": "npm run dev --workspace @smartflow/web",
    "build": "npm run build --workspace @smartflow/web",
    "preview": "npm run preview --workspace @smartflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
