{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm ci",
      "windows": {
        "command": "npm.cmd ci"
      },
      "problemMatcher": []
    },
    {
      "label": "Start web app",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Check repository",
      "type": "npm",
      "script": "check",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build web app",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
